{
  "name": "tmc-ui",
  "version": "0.1.5",
  "description": "Web interface for browsing Thing Models managed by TMC",
  "repository": {
    "type": "git",
    "url": "https://github.com/wot-oss/tmc-ui.git"
  },
  "homepage": "https://github.com/wot-oss/tmc-ui",
  "bugs": {
    "url": "https://github.com/wot-oss/tmc-ui/issues"
  }, 
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest",
    "test:integration": "vitest src/tests/integration",
    "test:integration:static": "vitest src/tests/integration/static",
    "test:integration:backend-no-auth": "vitest src/tests/integration/backend-no-auth",
    "test:integration:backend-with-auth": "vitest src/tests/integration/backend-with-auth",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf node_modules dist build && yarn install && yarn build",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "setup:local": "yarn install && yarn build && vite preview"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "wot-typescript-definitions": "^0.8.0-SNAPSHOT.31"
  },
  "devDependencies": {
    "@testing-library/react": "^14.2.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-router-dom": "^5.3.3",
    "@vitest/coverage-v8": "^4.1.9",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.31",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.0",
    "vite": "^4.4.9",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.20.0"
  }
}
